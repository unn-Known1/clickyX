  "version": "0.2.3",
  "description": "ClickyX — cross-platform AI desktop companion (voice, screen context, computer use, local-first, no telemetry)",
  "keywords": [
    "ai",
    "assistant",
    "desktop",
    "tauri",
    "computer-use",
    "voice",
    "local-first",
    "open-source"
  ],
