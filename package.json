    "@tauri-apps/plugin-updater": "^2",
    "highlight.js": "^11",
    "i18next": "^23",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17",
    "react-markdown": "^10",
    "rehype-highlight": "^7",
    "remark-gfm": "^4",
    "three": "^0.186",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186",
    "@vitejs/plugin-react": "^4",
