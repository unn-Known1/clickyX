  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unn-Known1/clickyX.git"
  },
  "homepage": "https://github.com/unn-Known1/clickyX#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
